<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime (required for notarization) blocks the mic without this. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- WhisperKit compiles CoreML models at runtime, which the hardened runtime
       otherwise refuses as unsigned executable memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
